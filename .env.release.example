# Copy to .env.release (gitignored) and fill in. Read by scripts/release-appstore.sh and scripts/release-macos.sh.
# Values set in your shell take priority over this file. Quote values that contain spaces.

# ---- App Store Connect API key (iOS upload) ----
# App Store Connect → Users and Access → Integrations → App Store Connect API (App Manager role).
# Put the downloaded AuthKey_<KEY ID>.p8 in ~/.appstoreconnect/private_keys/.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Optional: defaults to the current time (yymmddHHMM).
# BUILD_NUMBER=

# ---- DMG signing and notarization (release-macos.sh) ----
# The "Developer ID Application" certificate in your keychain (`security find-identity -v -p codesigning` lists it).
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
APPLE_TEAM_ID=

# Notarize with ONE of these two:
# (a) Apple ID + an app-specific password from https://account.apple.com → Sign-In and Security.
APPLE_ID=
APPLE_PASSWORD=
# (b) An App Store Connect API key (can be the same one as above). Leave (a) empty if you use this.
# APPLE_API_KEY=
# APPLE_API_ISSUER=
# APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
