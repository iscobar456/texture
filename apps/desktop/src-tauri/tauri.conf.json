{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Texture",
  "version": "0.1.0",
  "identifier": "dev.hwscan.desktop",
  "build": {
    "beforeDevCommand": "node scripts/fetch-tectonic.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-tectonic.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Texture",
        "width": 1400,
        "height": 850
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
    "externalBin": ["binaries/tectonic"],
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
