{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Texture",
  "mainBinaryName": "texture",
  "version": "0.3.0",
  "identifier": "dev.texture.desktop",
  "build": {
    "beforeDevCommand": "node scripts/fetch-tectonic.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-tectonic.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Texture",
        "width": 1400,
        "height": 850,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/tectonic"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
